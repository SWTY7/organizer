{
  "manifest_version": 3,
  "name": "organizer — capture",
  "version": "0.2.0",
  "description": "Capture your Claude and ChatGPT conversations as .chat files. Nothing is uploaded anywhere.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "organizer — capture"
  }
}
